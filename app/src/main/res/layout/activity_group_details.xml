<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:fitsSystemWindows="true">

    <!-- MAIN CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="24dp">

        <!-- GROUP DETAILS CARD -->
        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp"
            android:elevation="6dp">

            <!-- BACK BUTTON -->
            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:text="← Back"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:backgroundTint="#159A78" />

            <!-- GROUP ICON -->
            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/ic_groups"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp" />

            <!-- GROUP TITLE -->
            <TextView
                android:id="@+id/tvGroupName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Champs Outing"
                android:textStyle="bold"
                android:textSize="28sp"
                android:textColor="#111111"
                android:textAlignment="center"
                android:layout_marginTop="16dp" />

            <!-- SUBTITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage and split shared expenses with your group members"
                android:textAlignment="center"
                android:textColor="#666666"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="24dp" />

            <!-- GROUP SUMMARY CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_input"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Group Information"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#111111" />

                <TextView
                    android:id="@+id/tvMembers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Members: 3"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tvCreatedBy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Created by: You"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Pending Calculation"
                    android:textColor="#159A78"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <!-- BUTTONS SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Expense Actions"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#111111"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <!-- CALCULATE BUTTON -->
            <Button
                android:id="@+id/btnCalculate"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Calculate Share"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="@android:color/white"
                android:backgroundTint="#4FA8E0" />

            <!-- VIEW SHARE BUTTON -->
            <Button
                android:id="@+id/btnViewShare"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="View Shared Expenses"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="@android:color/white"
                android:backgroundTint="#159A78"
                android:layout_marginTop="14dp" />

            <!-- INFO TEXT -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Once the expense is calculated, the calculation button will automatically disappear and only shared expenses can be viewed."
                android:textColor="#666666"
                android:textSize="12sp"
                android:textAlignment="center"
                android:layout_marginTop="18dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@android:color/white"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:elevation="8dp">

        <!-- HOME -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="11sp"
                android:textColor="#000000"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- EXPENSES -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_expenses" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expenses"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#159A78"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- HISTORY -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_history" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History"
                android:textSize="11sp"
                android:textColor="#000000"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- ACCOUNT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_account" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account"
                android:textSize="11sp"
                android:textColor="#000000"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>